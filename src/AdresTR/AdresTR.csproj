<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AdresTR</PackageId>
    <Description>Turkish free-text address parser, normalizer and validator. Parses il, ilçe, mahalle, street, door/flat numbers and postal codes, resolves them against the official administrative hierarchy and explains every correction. Offline, deterministic, ICU-independent.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="AdresTR.Tests" />
    <InternalsVisibleTo Include="AdresTR.Benchmarks" />
    <InternalsVisibleTo Include="AdresTR.DataBuilder" />
    <InternalsVisibleTo Include="AdresTR.Eval" />
  </ItemGroup>

</Project>
